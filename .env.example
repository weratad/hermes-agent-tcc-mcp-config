# tcc-mcp-config — MCP settings for the DEFAULT profile
# วางไฟล์นี้เป็น  $HERMES_HOME/.env  (แล้วเติมค่าจริง)  หรือกรอกผ่าน dashboard tab
#
# ต้องมี 3 ค่า:
#   TCC_MCP_URL      = URL ของ tcc-api /mcp (ต้องเข้าถึงได้จากใน gateway container)
#   TCC_MCP_KEY      = bearer ที่ gateway ยิงหา tcc-api /mcp  →  ต้องเท่ากับ MCP_TOKEN ของ tcc-api
#   TCC_GATEWAY_KEY  = คีย์ที่ backend ผู้เรียกใช้เป็น HERMES_API_KEY  →  ต้องเท่ากับ HERMES_API_KEY ของ tcc-ai-assistant

TCC_MCP_URL=https://api.example.com/mcp
TCC_MCP_KEY=<mcp-bearer-token>
TCC_GATEWAY_KEY=<gateway-key-min-16-chars>

# คีย์เก่าแบบมี suffix (_LOCAL / _STG / _PROD) ยังอยู่ได้ — ปลั๊กอินจะ copy ไปยังชื่อข้างบน
# ตอนอ่าน ถ้าชื่อใหม่ยังว่าง และจะไม่ลบของเก่า
