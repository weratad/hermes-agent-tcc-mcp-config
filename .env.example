# tcc-mcp-config — per-environment settings for the DEFAULT profile
# วางไฟล์นี้เป็น  $HERMES_HOME/.env  (แล้วเติมค่าจริง)  หรือกรอกผ่าน dashboard tab
#
# ต่อ 1 environment ต้องมี 3 ค่า:
#   TCC_MCP_URL_<ENV>     = URL ของ tcc-api /mcp (ต้องเข้าถึงได้จากใน gateway container)
#   TCC_MCP_KEY_<ENV>     = bearer ที่ gateway ยิงหา tcc-api /mcp  →  ต้องเท่ากับ MCP_TOKEN ของ tcc-api
#   TCC_GATEWAY_KEY_<ENV> = คีย์ที่ backend ผู้เรียกใช้เป็น HERMES_API_KEY  →  ต้องเท่ากับ HERMES_API_KEY ของ tcc-ai-assistant
#
# ตั้งเฉพาะ env ที่ใช้จริงก็ได้ (ไม่จำเป็นต้องครบ 3)

# ── LOCAL ──────────────────────────────────────────────
TCC_MCP_URL_LOCAL=http://host.docker.internal:3363/mcp
TCC_MCP_KEY_LOCAL=<mcp-bearer-token>
TCC_GATEWAY_KEY_LOCAL=<gateway-key-min-16-chars>

# ── STAGING ────────────────────────────────────────────
TCC_MCP_URL_STG=https://api.tcc-stg.com/mcp
TCC_MCP_KEY_STG=<mcp-bearer-token>
TCC_GATEWAY_KEY_STG=<gateway-key-min-16-chars>

# ── PRODUCTION ─────────────────────────────────────────
TCC_MCP_URL_PROD=https://api.theconcert.com/mcp
TCC_MCP_KEY_PROD=<mcp-bearer-token>
TCC_GATEWAY_KEY_PROD=<gateway-key-min-16-chars>

# หมายเหตุ: Gateway Key ของแต่ละ env "ห้ามซ้ำกัน" ไม่งั้น env หนึ่งจะเข้าถึงโปรไฟล์ของอีก env ได้
